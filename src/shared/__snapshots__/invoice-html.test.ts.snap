// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots the complete original invoice HTML 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:"><title>Tax Invoice INV-0001</title><style>
  
  @page{size:A4 portrait;margin:10mm}
  *{box-sizing:border-box}body{margin:0;background:white;color:#0f172a;font:10pt BillSathiPrint,Arial,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}p{margin:5px 0;white-space:pre-wrap;overflow-wrap:anywhere}h1{font-size:24px;margin:0 0 8px}h2{font-size:19px;margin:0 0 8px;color:#2563EB}h3{font-size:12px}header{display:flex;justify-content:space-between;gap:16px;border-bottom:2px solid #2563EB;padding-bottom:15px}header>div:last-child{text-align:right}.invoice{padding-top:0mm;break-after:page}.invoice:last-child{break-after:auto}.company{display:flex;gap:12px}.logo{width:64px;height:64px;object-fit:contain}.party{display:flex;justify-content:space-between;gap:20px;margin:16px 0}.party>div{width:48%}table{border-collapse:collapse;width:100%;table-layout:auto}th{white-space:nowrap;overflow-wrap:normal;min-width:32px;background:#2563EB;color:white;text-align:left;font-weight:600}.items td:first-child{min-width:85px;width:20%}table{font-size:10pt}td,th{padding:7px 5px;border:1px solid #e2e8f0;overflow-wrap:anywhere}.num{text-align:right;white-space:nowrap}thead{display:table-header-group}tr{break-inside:avoid}.blank{height:25px}.bottom{display:flex;justify-content:space-between;gap:20px;padding-top:12px}.bottom>div{width:48%}.sum{display:flex;justify-content:space-between;gap:20px;padding:5px 0}.grand{border-top:2px solid #2563EB;font-size:16px}.footer-grid{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-top:16px}.qr-caption{text-align:center;max-width:180px}.qr-caption p{font-size:9px}.qr{width:96px;height:96px}.signature{width:100px;height:48px;object-fit:contain}.boxes{display:flex;gap:16px;margin-top:18px}.boxes>div{border:1px solid #e2e8f0;padding:12px;min-height:55px;flex:1}footer{margin-top:18px;break-inside:avoid}
  .modern header{background:#2563EB;padding:20px;color:white;border-radius:12px}.modern h2{color:white}.modern th{background:#f5f7fb;color:#0f172a}.minimal th{background:white;color:#0f172a;border-width:0 0 1px}.minimal td{border-width:0 0 1px}.minimal header{border-width:1px}.bold header{border-top:12px solid #2563EB;padding-top:20px}.bold h1{text-transform:uppercase;font-size:30px}.compact td,.compact th{padding:4px}.compact .blank{height:16px}.compact .party{margin:8px 0}.elegant{font-family:Georgia,BillSathiPrint,serif}.elegant header{border-bottom:double 4px #2563EB}.elegant h1{letter-spacing:1px}.elegant th{background:white;color:#2563EB;border-bottom:2px solid #2563EB}
  
  .bottom{break-inside:avoid}.blank td{padding-top:0;padding-bottom:0}
  </style></head><body><article class="invoice classic">
    <header><div class="company"><div><h1>BillSathi Test Store</h1><p>Bengaluru</p><p>9876543210 </p><p>GSTIN: 29ABCDE1234F1Z5</p></div></div><div><h2>Tax Invoice</h2><p>Original for recipient</p><p>Document number: <strong>INV-0001</strong></p><p>Date: 10/11/2026</p><p>Due date: 10/12/2026</p></div></header>
    
    <section class="party"><div><strong>Asha</strong><p></p><p></p><p>GSTIN: 29ABCDE1234F1Z5</p></div><div><p>Place of supply: 29 · Karnataka</p><p>Reverse charge: No</p></div></section>
    <table class="items"><thead><tr><th>Item</th><th>HSN</th><th>Qty</th><th>Unit</th><th>Rate</th><th>Disc</th><th>Taxable</th><th>CGST</th><th>SGST</th><th>IGST</th><th>Amount</th></tr></thead><tbody><tr><td class="">Notebook</td><td class="num">4820</td><td class="num">1</td><td class="num"></td><td class="num">₹100.00</td><td class="num">₹0.00</td><td class="num">₹100.00</td><td class="num">9%<br>₹9.00</td><td class="num">9%<br>₹9.00</td><td class="num">0%<br>₹0.00</td><td class="num">₹118.00</td></tr><tr class="blank"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr><tr class="blank"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr><tr class="blank"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr><tr class="blank"><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr></tbody></table>
    <section class="bottom"><div><p><strong>Amount in words</strong><br>One Hundred Eighteen Rupees Only</p><p>Total quantity: 1</p><p>You saved: ₹0.00</p></div><div class="totals"><div class="sum "><span>Taxable value</span><strong>₹100.00</strong></div><div class="sum "><span>CGST</span><strong>₹9.00</strong></div><div class="sum "><span>SGST</span><strong>₹9.00</strong></div><div class="sum "><span>IGST</span><strong>₹0.00</strong></div><div class="sum "><span>Round-off</span><strong>₹0.00</strong></div><div class="sum grand"><span>Total</span><strong>₹118.00</strong></div><div class="sum "><span>Received / settled</span><strong>₹18.00</strong></div><div class="sum "><span>Balance due</span><strong>₹100.00</strong></div></div></section>
    <h3>HSN-wise GST summary</h3><table><thead><tr><th>HSN</th><th>GST rate</th><th>Taxable</th><th>CGST</th><th>SGST</th><th>IGST</th></tr></thead><tbody><tr><td>4820</td><td>18%</td><td class="num">₹100.00</td><td class="num">₹9.00</td><td class="num">₹9.00</td><td class="num">₹0.00</td></tr></tbody></table>
    <footer><p><strong>Terms &amp; conditions</strong><br>Payment within 30 days</p>
    <div class="footer-grid"><div><strong>Bank details</strong><p>Example Bank</p><p>123456 BANK0000001</p><p>test@upi</p></div><div><p>Authorised signatory</p></div></div>
    </footer></article></body></html>"
`;
