{
  "name": "billsathi",
  "version": "0.1.0",
  "description": "Offline GST billing for Indian small businesses",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win nsis",
    "icons": "node scripts/make-icons.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.mts --silent=false",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "smoke": "node scripts/smoke.cjs",
    "smoke:masters": "node scripts/masters-smoke.cjs",
    "smoke:sales": "node scripts/sales-smoke.cjs",
    "smoke:safety": "node scripts/safety-smoke.cjs",
    "smoke:payments": "node scripts/payments-smoke.cjs",
    "smoke:dev": "node scripts/dev-smoke.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "smoke:finance": "node scripts/finance-smoke.cjs",
    "smoke:reports": "node scripts/reports-smoke.cjs",
    "smoke:packaged": "node scripts/packaged-smoke.cjs",
    "smoke:compliance": "node scripts/compliance-smoke.cjs",
    "smoke:orders": "node scripts/orders-smoke.cjs",
    "smoke:inventory": "node scripts/inventory-smoke.cjs",
    "smoke:walk": "node scripts/walk-smoke.cjs",
    "screenshots": "node scripts/screenshots.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "i18next": "^27.1.0",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^18.0.1",
    "recharts": "^3.10.1",
    "sql.js": "^1.15.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "author": "BillSathi contributors",
  "homepage": "https://github.com/tungaantu/BillSathi",
  "repository": {
    "type": "git",
    "url": "https://github.com/tungaantu/BillSathi.git"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
